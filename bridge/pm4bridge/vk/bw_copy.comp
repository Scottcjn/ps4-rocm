#version 450
// Same access pattern as kernels/copybw.cl copybw: each work group owns
// 256*iters consecutive dwords, each wave touches 64 consecutive dwords per step.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer S { uint s[]; };
layout(std430, binding = 1) buffer D { uint d[]; };
layout(push_constant) uniform PC { uint iters; uint value; } pc;
void main() {
    uint i = gl_WorkGroupID.x * 256u * pc.iters + gl_LocalInvocationID.x;
    for (uint k = 0u; k < pc.iters; k++, i += 256u) d[i] = s[i];
}

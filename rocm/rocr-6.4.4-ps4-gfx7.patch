diff --git a/runtime/hsa-runtime/core/runtime/amd_aql_queue.cpp b/runtime/hsa-runtime/core/runtime/amd_aql_queue.cpp
index f8613db..4191470 100644
--- a/runtime/hsa-runtime/core/runtime/amd_aql_queue.cpp
+++ b/runtime/hsa-runtime/core/runtime/amd_aql_queue.cpp
@@ -1675,8 +1675,30 @@ void AqlQueue::ExecutePM4(uint32_t* cmd_data, size_t cmd_size_b, hsa_fence_scope
 
   // Wait for the packet to be consumed.
   if (agent_->supported_isas()[0]->GetMajorVersion() <= 8) {
-    while (queue->LoadReadIndexRelaxed() <= write_idx)
+    // PS4 bring-up: bounded wait with diagnostics instead of spinning forever.
+    const char* ps4_to = getenv("PS4_PM4_TIMEOUT_MS");
+    uint64_t ps4_limit_ms = ps4_to ? strtoull(ps4_to, nullptr, 0) : 0;
+    timespec ps4_t0; clock_gettime(CLOCK_MONOTONIC, &ps4_t0);
+    while (queue->LoadReadIndexRelaxed() <= write_idx) {
       os::YieldThread();
+      if (ps4_limit_ms) {
+        timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+        uint64_t ms = (t.tv_sec - ps4_t0.tv_sec) * 1000ull + (t.tv_nsec - ps4_t0.tv_nsec) / 1000000ll;
+        if (ms > ps4_limit_ms) {
+          const char* mk = getenv("PS4_PM4_MARKER");
+          volatile uint32_t* marker = mk ? (volatile uint32_t*)strtoull(mk, nullptr, 0) : nullptr;
+          fprintf(stderr,
+                  "[ps4] ExecutePM4 TIMEOUT after %llu ms: write_idx=%llu read_idx=%llu "
+                  "slot[0]=0x%08x (wrote 0x%08x) max_legacy_db=%llu marker=0x%08x\n",
+                  (unsigned long long)ms, (unsigned long long)write_idx,
+                  (unsigned long long)queue->LoadReadIndexRelaxed(), queue_slot[0], slot_data[0],
+                  (unsigned long long)queue->amd_queue_.max_legacy_doorbell_dispatch_id_plus_1,
+                  marker ? *marker : 0);
+          fflush(stderr);
+          _exit(77);
+        }
+      }
+    }
 
     if (in_signal) hsa_signal_store_screlease(*in_signal, 0);
   } else if (!in_signal) {
diff --git a/runtime/hsa-runtime/core/runtime/amd_gpu_agent.cpp b/runtime/hsa-runtime/core/runtime/amd_gpu_agent.cpp
index 2f8df06..d93dbad 100644
--- a/runtime/hsa-runtime/core/runtime/amd_gpu_agent.cpp
+++ b/runtime/hsa-runtime/core/runtime/amd_gpu_agent.cpp
@@ -2298,6 +2298,40 @@ void GpuAgent::InvalidateCodeCaches(void *ptr, size_t size) {
     assert(false && "Code cache invalidation not implemented for this agent");
   }
 
+  // PS4 (gfx7 Liverpool/Gladius) bring-up switch, PS4_ICACHE_MODE:
+  //   skip    - do not invalidate at all
+  //   probe   - run a single WRITE_DATA through the same ExecutePM4 path and report
+  //   kfdtest - ACQUIRE_MEM with the parameters kfdtest uses (whole range, poll 4)
+  //   (unset) - stock behaviour
+  const char* ps4_mode = getenv("PS4_ICACHE_MODE");
+  if (isa_->GetMajorVersion() == 7 && ps4_mode != nullptr) {
+    if (!strcmp(ps4_mode, "skip")) return;
+    if (!strcmp(ps4_mode, "probe")) {
+      static volatile uint32_t* marker = nullptr;
+      if (marker == nullptr) marker = (volatile uint32_t*)system_allocator()(0x1000, 0x1000, 0);
+      *marker = 0x11111111;
+      uint32_t wd[5];
+      wd[0] = PM4_HDR(PM4_HDR_IT_OPCODE_WRITE_DATA, 5, 7);
+      wd[1] = (5 << 8) | PM4_WRITE_DATA_WR_CONFIRM_WAIT_CONFIRMATION;  // dst_sel = memory
+      { uint64_t ma = uintptr_t(marker); wd[2] = uint32_t(ma) & 0xFFFFFFFCu; wd[3] = uint32_t(ma >> 32); }
+      wd[4] = 0xC0DEF00D;
+      setenv("PS4_PM4_MARKER", std::to_string(uintptr_t(marker)).c_str(), 1);
+      queues_[QueueUtility]->ExecutePM4(wd, sizeof(wd));
+      fprintf(stderr, "[ps4] ExecutePM4 probe returned, marker=0x%08x (want 0xc0def00d)\n", *marker);
+      return;
+    }
+    if (!strcmp(ps4_mode, "kfdtest")) {
+      uint32_t am[7] = {0};
+      am[0] = PM4_HDR(PM4_HDR_IT_OPCODE_ACQUIRE_MEM, 7, 7);
+      am[1] = 0x28c00000;
+      am[2] = 0xFFFFFFFF;
+      am[6] = 4;
+      queues_[QueueUtility]->ExecutePM4(am, sizeof(am));
+      fprintf(stderr, "[ps4] ExecutePM4 kfdtest-style ACQUIRE_MEM returned\n");
+      return;
+    }
+  }
+
   // Invalidate caches which may hold lines of code object allocation.
   uint32_t cache_inv[8] = {0};
   uint32_t cache_inv_size_dw;

    fprintf(f, "    has_smem_with_null_prt_bug = %i\n", info->compiler_info.has_smem_with_null_prt_bug);
+   fprintf(f, "    has_flat_hang_bug = %i\n", info->compiler_info.has_flat_hang_bug);
+   fprintf(f, "    has_lds_b128_bug = %i\n", info->compiler_info.has_lds_b128_bug);
 
    fprintf(f, "Ring info:\n");
    if (info->gfx_level >= GFX11) {

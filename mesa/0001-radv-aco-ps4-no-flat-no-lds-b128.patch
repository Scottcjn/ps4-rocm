+   /* The PS4 APUs (Liverpool and Gladius) are semi-custom GFX7 chips that the
+    * kernel reports as Kaveri, so they can only be identified by PCI ID.
+    *
+    * FLAT memory instructions hang the GPU ("ring comp/gfx timeout"), while
+    * MUBUF with ADDR64 works, so global memory must be accessed the GFX6 way.
+    * ds_read_b128/ds_write_b128 also return/store wrong LDS data, while 64-bit
+    * and narrower LDS accesses are fine.
+    */
+   const bool is_ps4 = info->gfx_level == GFX7 &&
+                       (info->pci_id == 0x9920 || /* Liverpool (PS4) */
+                        info->pci_id == 0x9924);  /* Gladius (PS4 Pro) */
+   out->has_flat_hang_bug = is_ps4;
+   out->has_lds_b128_bug = is_ps4;
+
    /* On GFX6-8, SMEM loads on a NULL PRT page return garbage instead of zero.
     * On GFX10-12, SMEM loads on a NULL PRT page throws a VM fault and hangs the GPU.
     *
@@ -2198,6 +2212,8 @@ void ac_print_gpu_info(FILE *f, const struct radeon_info *info, int fd)
